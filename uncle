#!/usr/bin/env bash
set -euo pipefail

# The caller's working directory is the project being configured; the scripts
# cd to the install dir ($ROOT), so capture it before that happens.
PROJECT_ROOT="$PWD"

# $ROOT must be the directory holding uncle_tui.py, scripts/, prompts/, and
# lib/ -- not the directory this was invoked from. A packaged install (Homebrew
# puts the payload in libexec and links bin/uncle to it) reaches us through one
# or more symlinks, and BASH_SOURCE reports the link, not its target, so walk
# the chain by hand. macOS ships BSD readlink, which has no -f.
uncle_self="${BASH_SOURCE[0]}"
while [[ -L "$uncle_self" ]]; do
    uncle_link="$(readlink "$uncle_self")"
    case "$uncle_link" in
        /*) uncle_self="$uncle_link" ;;
        *)  uncle_self="$(cd "$(dirname "$uncle_self")" && pwd)/$uncle_link" ;;
    esac
done
ROOT="$(cd "$(dirname "$uncle_self")" && pwd)"
unset uncle_self uncle_link
case "${OSTYPE:-}" in
    msys*|cygwin*|win32*)
        export UNCLE_WINDOWS_BASH="$(cygpath -w "$BASH")"
        if ! python3 -c pass >/dev/null 2>&1; then
            export PATH="$ROOT/packaging/windows:$PATH"
        fi
        ;;
esac
cd "$ROOT"
. "$ROOT/scripts/lib/stage-config.sh"

# ANSI palette matching cline's CLI. Disabled when stdout is not a terminal or
# NO_COLOR is set, so piped/scripted output stays machine-readable.
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    C_RESET=$'\033[0m'
    C_DIM=$'\033[2m'
    C_BOLD=$'\033[1m'
    C_CYAN=$'\033[36m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_RED=$'\033[31m'
    C_GRAY=$'\033[90m'
else
    C_RESET='' C_DIM='' C_BOLD='' C_CYAN='' C_GREEN='' C_YELLOW='' C_RED='' C_GRAY=''
fi

usage() {
    cat <<'EOF'
Usage: uncle [-h|--help|--performance] [--unattended]

Interactive launcher for the governed-CI workflows. Picks one of the three
drivers and runs the stages through `cline` using the model, reasoning effort,
and per-stage overrides from `.uncle/config` (menu option 4).

  1) New application   -> ./scripts/stagegate.sh
  2) From GitHub issue -> ./scripts/from-issue.sh
  3) Change request    -> ./scripts/change-workflow.sh
    4) Configure stages  -> .uncle/config
  q) Quit

Runs with no arguments. -h / --help print this message and exit 0.
--performance reports recorded runtime and token usage for the current project.
--unattended is passed to the driver you pick: it runs every human gate
without a person, records what nobody reviewed, and reports that at the end.
EOF
}

# Collected here and handed to whichever driver the menu picks, so the choice
# of workflow and the choice to run it unattended stay independent.
UNCLE_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)     usage; exit 0 ;;
        --performance) exec bash "$ROOT/scripts/performance-report.sh" "$PROJECT_ROOT" ;;
        --unattended)  UNCLE_ARGS+=(--unattended); shift ;;
        *)             printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 1 ;;
    esac
done

# Per-project paths/config. Resolve and export these BEFORE launching the TUI:
# the launcher has already cd'd into the install libexec, so without this the
# TUI would key its per-project state off the install dir and write
# .uncle/config to the wrong place. UNCLE_CONFIG wins if the caller sets it.
CLINE_CONFIG="${CLINE_CONFIG:-$HOME/.cline/data/settings/providers.json}"
CL_MODEL=""
CL_EFFORT="medium"
UNCLE_CONFIG="${UNCLE_CONFIG:-$PROJECT_ROOT/.uncle/config}"
export UNCLE_CONFIG
export UNCLE_PROJECT_ROOT="$PROJECT_ROOT"
CONFIG_STAGES="requirements baseline change-spec project-plan change-plan adversarial-review updated-plan updated-change-plan preflight implementation test-review manual-checklist execute-checklist final-audit"

# Full-screen terminal UI when both stdin and stdout are real terminals; the
# line-based menu below remains for pipes and scripts.
if [[ -t 0 && -t 1 ]] && python3 -c pass >/dev/null 2>&1; then
    if python3 "$ROOT/uncle_tui.py"; then
        exit 0
    fi
    # TUI failed (e.g. unsupported terminal); fall through to the line menu.
fi


# Per-stage settings, as the drivers' variables.
#
# Every stage is configured on its own: a runner, a reasoning effort, and — for
# a cline stage only — a model. The other runners are given no model flag and
# use their own default, so `uncle` never invents one for them.
CONFIG_STAGE_SIDE_reviewer=" adversarial-review test-review manual-checklist final-audit "
DEFAULT_EFFORT="medium"
DEFAULT_CLINE_MODEL="cline-pass/deepseek-v4-pro"

stage_side() {
    case "$CONFIG_STAGE_SIDE_reviewer" in
        *" $1 "*) printf 'reviewer' ;;
        *)        printf 'agent' ;;
    esac
}

stage_env_var() {
    printf 'WORKFLOW_MODEL_%s' \
        "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_')"
}

effort_env_var() {
    printf 'WORKFLOW_EFFORT_%s' \
        "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_')"
}

cmd_env_var() {
    local prefix="WORKFLOW_AGENT_CMD_"
    [[ "$(stage_side "$1")" == "reviewer" ]] && prefix="WORKFLOW_REVIEWER_CMD_"
    printf '%s%s' "$prefix" \
        "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_')"
}

# The CLI that runs one stage. The two sides are not interchangeable: an agent
# stage writes code, a reviewer stage must stay read-only, and codex has no
# agent shim.
runner_cmd() {
    local runner="$1" side="$2"
    if [[ "$side" == "reviewer" ]]; then
        case "$runner" in
            kimi)   printf '%s' "$ROOT/scripts/reviewer-kimi.sh" ;;
            codex)  printf 'codex' ;;
            claude) printf '%s' "$ROOT/scripts/reviewer-claude.sh" ;;
            *)      printf '%s' "$ROOT/scripts/reviewer-cline.sh" ;;
        esac
        return 0
    fi
    case "$runner" in
        claude) printf 'claude' ;;
        kimi)   printf '%s' "$ROOT/scripts/agent-kimi.sh" ;;
        codex)  printf '%s' "$ROOT/scripts/agent-codex.sh" ;;
        *)      printf '%s' "$ROOT/scripts/agent-cline.sh" ;;
    esac
}

# Read one stage's setting out of .uncle/config: `<stage>.<field> VALUE`.
config_get() {
    local key="$1" line
    while IFS= read -r line; do
        if [[ "${line%% *}" == "$key" ]]; then
            printf '%s' "${line#* }"
            return 0
        fi
    done < <(config_read)
    return 0
}

# Nothing per-stage is exported: the drivers read .uncle/config themselves, at
# the moment each stage starts, so an edit made at a human gate applies to the
# stages after it. UNCLE_CONFIG (exported above) tells them which file to read.

logo_lines() {
    cat <<'LOGO'
                    #@@@@@@##@@@@@@#
                    @@@@@@@@@@@@@@@@
                    @@@@@@@@@@@@@@@@
                   #@@@@@@@@@@@@@@@@#
                   @@@@@@@@@@@@@@@@@@
        #@@@@@@@@@ @@@@@@@@@@@@@@@@@@ @@@@@@@@@#
        @@@@@@@@@@                    @@@@@@@@@@
         @@@@@@@@@@@@@@##########@@@@@@@@@@@@@@
           #@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
              #@@##@@@@@@@@@@@@@@@@@@##@@#
           #@@@@@# @@@@@@@@##@@@@@@@@ #@@@@@#
         @@@@@@@@@  @@@@@@    @@@@@@  @@@@@@@@@
        @@@@@@@@@@@                  @@@@@@@@@@@
         @@@@@@@@@@@                @@@@@@@@@@@
          #@@@@@@@@@@              @@@@@@@@@@#
           ##@@@@@@@@@@          @@@@@@@@@@##
        #@@@@@@@@@@@@@@@@#    #@@@@@@@@@@@@@@@@#
      @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    #@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
     #@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
        #@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
           #@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
LOGO
}

print_logo() {
    local line w maxw pad
    w="${COLUMNS:-0}"
    [[ "$w" =~ ^[0-9]+$ ]] || w=0
    maxw=0
    while IFS= read -r line; do
        if (( ${#line} > maxw )); then maxw=${#line}; fi
    done < <(logo_lines)
    pad=''
    if (( w > maxw )); then
        pad="$(printf '%*s' "$(( (w - maxw) / 2 ))" '')"
    fi
    while IFS= read -r line; do
        printf '%s%s%s%s\n' "$pad" "$C_CYAN" "$line" "$C_RESET"
    done < <(logo_lines)
    printf '%s%*s%suncle%s\n' "$pad" "$(( (maxw - 5) / 2 ))" '' "$C_CYAN" "$C_RESET"
}

print_menu() {
    cat <<EOF

EOF
    print_logo
    cat <<EOF

  ${C_CYAN}${C_BOLD}1)${C_RESET} New application   ${C_GRAY}-> ./scripts/stagegate.sh${C_RESET}
  ${C_CYAN}${C_BOLD}2)${C_RESET} From GitHub issue ${C_GRAY}-> ./scripts/from-issue.sh${C_RESET}
  ${C_CYAN}${C_BOLD}3)${C_RESET} Change request    ${C_GRAY}-> ./scripts/change-workflow.sh${C_RESET}
  ${C_CYAN}${C_BOLD}4)${C_RESET} Configure stages  ${C_GRAY}-> .uncle/config${C_RESET}
  ${C_CYAN}${C_BOLD}q)${C_RESET} Quit

  config: ${C_GRAY}$UNCLE_CONFIG${C_RESET}

EOF
}

# Run a workflow command, report a non-zero exit, and always return success so
# the menu keeps looping after a driver fails.
launch() {
    local status=0
    "$@" || status=$?
    if [[ "$status" -ne 0 ]]; then
        printf '\n%s%s exited with status %s.%s\n' "$C_RED" "$1" "$status" "$C_RESET"
    fi
    return 0
}

choose_model() {
    local models_file line n sel idx
    models_file="$(mktemp)"
    # `select(contains("/"))`: cline needs modelType/model, and providers.json
    # can hold a stale display name as a provider's last-used model. Offering
    # one here is how it ends up in .uncle/config and then in `cline -m`.
    jq -r '.providers[]?.settings.model // empty | select(contains("/"))' \
        "$CLINE_CONFIG" 2>/dev/null | sort -u > "$models_file" || true

    while true; do
        echo
        printf 'Model (current: %s)\n' "${C_CYAN}${CL_MODEL:-cline default}${C_RESET}"
        n=0
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            n=$((n+1))
            printf '  %s%d)%s %s\n' "$C_CYAN" "$n" "$C_RESET" "$line"
        done < "$models_file"
        printf '  %sc)%s custom model id\n' "$C_CYAN" "$C_RESET"

        if (( n > 0 )); then
            printf '%s' "Choice [1-$n/c/Enter=keep]: "
        else
            printf '%s' "Choice [c/Enter=keep]: "
        fi
        if ! read -r sel; then
            echo
            break
        fi
        sel="$(printf '%s' "$sel" | tr -d '[:space:]')"

        case "$sel" in
            "")
                break ;;
            c|C)
                printf '%s' "Model id (modelType/model, e.g. cline-pass/kimi-k3): "
                if read -r sel; then
                    sel="$(printf '%s' "$sel" | tr -d '[:space:]')"
                    if [[ -n "$sel" && "$sel" != */* ]]; then
                        printf '%sNot a cline model id: %s (expected modelType/model)%s\n' \
                            "$C_YELLOW" "$sel" "$C_RESET"
                        continue
                    fi
                    CL_MODEL="$sel"
                else
                    echo
                    CL_MODEL=""
                fi
                break ;;
            *)
                if [[ "$sel" =~ ^[0-9]+$ ]] && (( n > 0 && sel >= 1 && sel <= n )); then
                    idx=0
                    while IFS= read -r line; do
                        [[ -z "$line" ]] && continue
                        idx=$((idx+1))
                        if (( idx == sel )); then
                            CL_MODEL="$line"
                            break
                        fi
                    done < "$models_file"
                    break
                fi
                printf 'Unrecognized choice: %s\n' "$sel"
                ;;
        esac
    done
    rm -f "$models_file"
    return 0
}

choose_effort() {
    local sel
    while true; do
        printf '%s' "Performance [h]igh/[m]edium/[l]ow (current: ${C_CYAN}$CL_EFFORT${C_RESET}, Enter=keep): "
        if ! read -r sel; then
            echo
            break
        fi
        sel="$(printf '%s' "$sel" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
        case "$sel" in
            "") break ;;
            h|high)   CL_EFFORT="high"; break ;;
            m|medium) CL_EFFORT="medium"; break ;;
            l|low)    CL_EFFORT="low"; break ;;
            *) printf 'Unrecognized choice: %s\n' "$sel" ;;
        esac
    done
    return 0
}

run_workflow() {
    # UNCLE_CLINE_MODEL / UNCLE_CLINE_EFFORT are deliberately not exported:
    # they are global overrides inside the cline shims and would win over the
    # per-stage settings the drivers resolve from .uncle/config.
    local approval_name
    approval_name="$(config_get misc.approval_name)"
    if [[ "$(config_get misc.auto_mode)" == true ]]; then
        UNCLE_APPROVAL_NAME="$approval_name" launch "$@" --unattended
    else
        UNCLE_APPROVAL_NAME="$approval_name" launch "$@"
    fi
}

config_write_header() {
    cat <<'EOF'
# Uncle per-stage config: every stage picks its own runner, reasoning effort,
# and -- for a cline stage -- model.
# Format: <stage>.runner | <stage>.effort | <stage>.model VALUE
#   (VALUE = a runner name, a reasoning effort, or a cline model id in
#   modelType/model form). Edit from `uncle` -> Configure, or by hand.
EOF
}

config_read() {
    local line
    [[ -s "$UNCLE_CONFIG" ]] || return 0
    while IFS= read -r line; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | tr -s '[:space:]' ' ')"
        [[ -n "$line" ]] || continue
        printf '%s\n' "$line"
    done < "$UNCLE_CONFIG"
}

config_set() {
    local stage="$1" model="$2" tmp found=0
    tmp="$(mktemp)"
    while IFS= read -r line; do
        if [[ "${line%% *}" == "$stage" ]]; then
            printf '%s %s\n' "$stage" "$model"
            found=1
        else
            printf '%s\n' "$line"
        fi
    done < <(config_read) > "$tmp"
    [[ "$found" == "0" ]] && printf '%s %s\n' "$stage" "$model" >> "$tmp"
    config_write_header > "$UNCLE_CONFIG"
    cat "$tmp" >> "$UNCLE_CONFIG"
    rm -f "$tmp"
}

config_clear() {
    local stage="$1" tmp
    tmp="$(mktemp)"
    while IFS= read -r line; do
        [[ "${line%% *}" == "$stage" ]] || printf '%s\n' "$line"
    done < <(config_read) > "$tmp"
    config_write_header > "$UNCLE_CONFIG"
    cat "$tmp" >> "$UNCLE_CONFIG"
    rm -f "$tmp"
}

# One stage at a time: pick the stage, then its runner, effort, and — only
# when the runner is cline — its model. This is the fallback for a terminal the
# full-screen TUI cannot drive; both write the same file.
configure_stage() {
    local stage="$1" side sel runner model effective
    side="$(stage_side "$stage")"
    while true; do
        effective="$(uncle_stage_runner "$stage")"
        echo
        printf '%s%s%s  (%s stage)\n' "$C_CYAN$C_BOLD" "$stage" "$C_RESET" "$side"
        printf '  runner  %s\n' "${effective}${C_DIM}${C_RESET}"
        printf '  effort  %s\n' "$(uncle_stage_effort "$stage")"
        if [[ "${effective}" == "self-hosted" ]]; then
            printf '  model     %s\n' "$(config_get "$stage.model")"
            printf 'Set [r]unner [m]odel, [a]pply OpenCode to all stages, [d]efaults, [q]back: '
        elif [[ "${effective}" == "cline" ]]; then
            printf '  model   %s\n' "$(config_get "$stage.model")"
            printf '%s' "Set [${C_CYAN}r${C_RESET}]unner [${C_CYAN}e${C_RESET}]ffort [${C_CYAN}m${C_RESET}]odel, [${C_CYAN}d${C_RESET}]efaults, [${C_CYAN}q${C_RESET}]back: "
        else
            printf '  model   %s(runner default)%s\n' "$C_DIM" "$C_RESET"
            printf '%s' "Set [${C_CYAN}r${C_RESET}]unner [${C_CYAN}e${C_RESET}]ffort, [${C_CYAN}d${C_RESET}]efaults, [${C_CYAN}q${C_RESET}]back: "
        fi
        if ! read -r sel; then echo; return 0; fi
        sel="$(printf '%s' "$sel" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
        case "$sel" in
            r)
                local choices
                choices="$(uncle_installed_runners)"
                choices="${choices//$'\n'/ }"
                if [[ -z "$choices" ]]; then uncle_no_runner || true; continue; fi
                printf 'Runner (%s; opencode = Self hosted): ' "$choices"
                if ! read -r runner; then echo; return 0; fi
                runner="$(printf '%s' "$runner" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
                [[ "$runner" != "selfhosted" && "$runner" != "opencode" ]] || runner=self-hosted
                case " $choices " in
                    *" $runner "*)
                        config_set "$stage.runner" "$runner"
                        # Cline and self-hosted stages use an explicit model.
                        [[ "$runner" == "cline" || "$runner" == "self-hosted" ]] || config_clear "$stage.model"
                        ;;
                    *) printf '%sNot a %s runner: %s%s\n' "$C_YELLOW" "$side" "$runner" "$C_RESET" ;;
                esac
                ;;
            a)
                if [[ "${effective}" != "self-hosted" ]]; then
                    echo 'Select Self hosted and configure its connection first.'
                    continue
                fi
                local target field value
                for target in $CONFIG_STAGES; do
                    config_set "$target.runner" self-hosted
                    for field in model base_url; do
                        value="$(config_get "$stage.$field")"
                        if [[ -n "$value" ]]; then
                            config_set "$target.$field" "$value"
                        else
                            config_clear "$target.$field"
                        fi
                    done
                done
                python3 - "$ROOT/scripts/lib" "$UNCLE_CONFIG" "$stage" $CONFIG_STAGES <<'PYKEYS'
import sys
sys.path.insert(0, sys.argv[1])
from self_hosted import read_keys, save_keys
keys = read_keys(sys.argv[2])
value = keys.get(sys.argv[3], '')
for stage in sys.argv[4:]:
    if value:
        keys[stage] = value
    else:
        keys.pop(stage, None)
save_keys(sys.argv[2], keys)
PYKEYS
                echo 'OpenCode and this LLM connection selected for all stages.'
                ;;
            e)
                choose_effort
                config_set "$stage.effort" "$CL_EFFORT"
                ;;
            m)
                if [[ "${effective}" == "self-hosted" ]]; then
                    if ! model="$(python3 "$ROOT/scripts/lib/self_hosted.py" choose-model "$UNCLE_CONFIG")"; then continue; fi
                    config_set "$stage.model" "$model"
                    continue
                fi
                [[ "$effective" == cline ]] || continue
                choose_model
                if [[ -n "$CL_MODEL" ]]; then
                    config_set "$stage.model" "$CL_MODEL"
                else
                    config_clear "$stage.model"
                fi
                ;;
            d)
                config_clear "$stage.runner"
                config_clear "$stage.effort"
                config_clear "$stage.model"
                config_clear "$stage.base_url"
                printf '' | python3 "$ROOT/scripts/lib/self_hosted.py" set-key "$UNCLE_CONFIG" "$stage"
                ;;
            q|"") return 0 ;;
            *) printf 'Unrecognized choice: %s\n' "$sel" ;;
        esac
    done
}

configure_menu() {
    local choice value
    while true; do
        printf '\nConfigure\n  1) Configure stages\n  2) Configure OpenCode / self hosting\n  3) Miscellaneous\n  q) Back\nChoice: '
        read -r choice || return 0
        case "$choice" in
            1) configure_stages_menu ;;
            2) python3 "$ROOT/scripts/lib/self_hosted.py" models "$UNCLE_CONFIG" || true ;;
            3)
                printf 'Auto mode (true/false) [%s]: ' "$(config_get misc.auto_mode)"
                read -r value || return 0
                case "$value" in true|false) config_set misc.auto_mode "$value" ;; esac
                printf 'Name for approvals [%s]: ' "$(config_get misc.approval_name)"
                read -r value || return 0
                [[ -z "$value" ]] || config_set misc.approval_name "$value"
                ;;
            q|Q|"") return 0 ;;
        esac
    done
}

configure_stages_menu() {
    local sel stage n idx runner effort model
    while true; do
        echo
        echo "${C_CYAN}${C_BOLD}Configure stages${C_RESET} (${C_GRAY}$UNCLE_CONFIG${C_RESET})"
        n=0
        for stage in $CONFIG_STAGES; do
            n=$((n+1))
            runner="$(uncle_stage_runner "$stage")"
            effort="$(uncle_stage_effort "$stage")"
            [[ -n "$effort" ]] || effort="$DEFAULT_EFFORT"
            if [[ "$runner" == "cline" ]]; then
                model="$(config_get "$stage.model")"
                [[ -n "$model" ]] || model="$DEFAULT_CLINE_MODEL"
                printf '  %s%2d)%s %-22s %s · %s · %s\n' \
                    "$C_CYAN" "$n" "$C_RESET" "$stage" "$runner" "$model" "$effort"
            else
                printf '  %s%2d)%s %-22s %s · %s\n' \
                    "$C_CYAN" "$n" "$C_RESET" "$stage" "$runner" "$effort"
            fi
        done
        echo
        printf '%s' "Stage to configure [${C_CYAN}1-$n${C_RESET}/${C_CYAN}q${C_RESET}]: "
        if ! read -r sel; then echo; return 0; fi
        sel="$(printf '%s' "$sel" | tr -d '[:space:]')"
        case "$sel" in
            q|Q|"") return 0 ;;
            m|M) python3 "$ROOT/scripts/lib/self_hosted.py" models "$UNCLE_CONFIG" || true; continue ;;
        esac
        if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= n )); then
            idx=0
            for stage in $CONFIG_STAGES; do
                idx=$((idx+1))
                if (( idx == sel )); then
                    configure_stage "$stage"
                    break
                fi
            done
        else
            printf 'Unrecognized choice: %s\n' "$sel"
        fi
    done
}

run_new_application() {
    run_workflow "$ROOT/scripts/stagegate.sh" ${UNCLE_ARGS[@]+"${UNCLE_ARGS[@]}"}
}

run_from_issue() {
    local issue mode flag
    issue=""
    while [[ -z "$issue" ]]; do
        printf '%s' "Issue number or URL: "
        if ! read -r issue; then
            echo
            return 0
        fi
        issue="$(printf '%s' "$issue" | tr -d '[:space:]')"
    done

    flag=""
    while true; do
        printf '%s' "Seed as [c]hange request or [n]ew application? [c/n/Enter=auto]: "
        if ! read -r mode; then
            echo
            break
        fi
        mode="$(printf '%s' "$mode" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
        case "$mode" in
            c|change) flag="--change"; break ;;
            n|new)    flag="--new"; break ;;
            "")       break ;;
            *)        printf 'Unrecognized choice: %s\n' "$mode" ;;
        esac
    done

    if [[ -n "$flag" ]]; then
        run_workflow "$ROOT/scripts/from-issue.sh" "$issue" "$flag"
    else
        run_workflow "$ROOT/scripts/from-issue.sh" "$issue"
    fi
    return 0
}

run_change_workflow() {
    run_workflow "$ROOT/scripts/change-workflow.sh" ${UNCLE_ARGS[@]+"${UNCLE_ARGS[@]}"}
}

# First time in this project root (no .uncle/config yet): create the workflow directory
# dir the scripts write state/logs into, then go straight to the configure menu
# so this project gets set up before any workflow runs.
if [[ ! -s "$UNCLE_CONFIG" ]]; then
    mkdir -p "$PROJECT_ROOT/.uncle/workflow"
    configure_menu
    # Configure may quit without saving anything; write a minimal default so
    # this is still recognized as configured on the next run.
    # Persist effort only; the runner remains inherited from PATH.
    [[ -s "$UNCLE_CONFIG" ]] || {
        config_write_header > "$UNCLE_CONFIG"
        printf 'requirements.effort %s\n' "$DEFAULT_EFFORT" >> "$UNCLE_CONFIG"
    }
fi

while true; do
    print_menu
    printf '%s' "Choose [${C_CYAN}1-4/q${C_RESET}]: "
    if ! read -r choice; then
        echo
        break
    fi
    choice="$(printf '%s' "$choice" | tr -d '[:space:]')"
    case "$choice" in
        1)
            if [[ ! -f "$PROJECT_ROOT/REQUIREMENTS.md" ]]; then
                printf '%sREQUIREMENTS.md is needed in the project root.%s\n' "$C_YELLOW" "$C_RESET"
                continue
            fi
            run_new_application
            ;;
        2) run_from_issue ;;
        3)
            if [[ ! -f "$PROJECT_ROOT/CHANGE_REQUEST.md" ]]; then
                printf '%sCHANGE_REQUEST.md is needed in the project root.%s\n' "$C_YELLOW" "$C_RESET"
                continue
            fi
            run_change_workflow
            ;;
        4) configure_menu ;;
        q|Q|"") break ;;
        *) printf '%sUnrecognized choice: %s%s\n' "$C_YELLOW" "$choice" "$C_RESET" ;;
    esac
done

exit 0
