# Uncle state is ignored, but the change attestation and its trust root are committed on the feature
# branch; a negation only works under `.uncle/*`, never `.uncle/`.
.uncle/*
!.uncle/docs/
!.uncle/attestation.json
!.uncle/attestation.sig
!.uncle/allowed_signers

# Local agent workflow state
.uncle/workflow/state
.uncle/workflow/approvals/
.uncle/workflow/logs/
.uncle/workflow/change.diff
.uncle/workflow/change-stat.txt

# Per-project local config (committed template lives at .uncle/config.example)
.uncle/config

# Local model catalog cache
.uncle/model-catalog.json

# Python bytecode
__pycache__/
*.pyc


# Self-hosted model credentials
.uncle/self-hosted-keys.json
.aider*

# A test run from this directory once left a whole .uncle/workflow here (and committed it).
scripts/tests/.uncle/

# Temporary pieces of split test suites (scripts/lib/suite_split.py); removed when each piece ends
scripts/tests/.part*
.uncle
