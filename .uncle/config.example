# Uncle per-stage config: every stage picks its own runner, reasoning effort,
# and -- for a cline stage -- model.
#
# Format: <stage>.runner | <stage>.effort | <stage>.model | <stage>.network
#         | <stage>.billing VALUE
#
#   .runner  cline | claude | kimi | codex | self-hosted for any stage
#            self-hosted uses OpenCode (opencode is also accepted).
#   .effort  high | medium | low
#   .model   a cline model id in modelType/model form, and only for a cline
#            stage: claude, kimi, and codex are given no model flag and use
#            their own default.
#            For self-hosted stages, select a discovered model in Configure ->
#            Configure OpenCode / self hosting. API keys are stored separately.
#   .billing clinepass | cline-usage (default clinepass) -- which cline
#            catalogue and purse a cline stage uses. Not a flag: cline reads
#            it from the model id, so `cline-pass/kimi-k3` spends the
#            subscription and a vendor-prefixed `kimi-k3` spends usage
#            billing. An explicit .model therefore settles it and wins over
#            this line; the setting decides the default model and which list
#            the Configure picker offers.
#   .network true | false (default false) -- whether the stage's sandbox may
#            reach the network. Only codex sandboxes its stages; cline, kimi,
#            and claude ignore this. A stage that has to serve the product it
#            is verifying needs it, because codex's workspace-write sandbox
#            denies loopback binds. Leave it off everywhere else: an agent that
#            writes code and can also open a socket is a different proposition.
#
# A stage that is not listed here runs on the defaults: cline, medium effort,
# and cline-pass/deepseek-v4-pro. Edit from `uncle` -> Configure, or by hand.

# --- new application ---------------------------------------------------------

# Reading a brief and writing it out again does not need the top tier.
requirements.runner cline
requirements.model cline-pass/deepseek-v4-flash
requirements.effort medium

# The plan carries the design.
project-plan.runner cline
project-plan.model cline-pass/kimi-k3
project-plan.effort high

updated-plan.runner cline
updated-plan.model cline-pass/kimi-k3
updated-plan.effort high

# Preflight must exercise the capabilities later stages depend on, which means
# it needs whatever they need -- otherwise it probes under conditions the real
# stage will not have and passes a prerequisite that later blocks.
preflight.runner cline
preflight.model cline-pass/deepseek-v4-flash
preflight.effort medium
preflight.network true

# Implementation is the stage worth paying for.
implementation.runner claude
implementation.effort high

# Executing the checklist means running the product, which for anything that
# serves over HTTP means binding a port. Without this the browser and GUI rows
# record BLOCKED on every attempt, and repairs cannot fix a missing socket.
execute-checklist.runner cline
execute-checklist.model cline-pass/deepseek-v4-flash
execute-checklist.effort medium
execute-checklist.network true

# --- change request ----------------------------------------------------------

baseline.runner cline
baseline.model cline-pass/deepseek-v4-flash
baseline.effort medium

change-spec.runner cline
change-spec.model cline-pass/deepseek-v4-pro
change-spec.effort medium

change-plan.runner cline
change-plan.model cline-pass/kimi-k3
change-plan.effort high

updated-change-plan.runner cline
updated-change-plan.model cline-pass/kimi-k3
updated-change-plan.effort high

# --- review (both workflows) -------------------------------------------------

# A critic that did not write the code is the point, so these are worth
# pointing at a different program from the implementer.
adversarial-review.runner codex
adversarial-review.effort high

test-review.runner codex
test-review.effort high

manual-checklist.runner cline
manual-checklist.model cline-pass/glm-5.3
manual-checklist.effort medium

final-audit.runner codex
final-audit.effort high

# Self-hosted Aider runner using an OpenAI-compatible endpoint.
# Configure → Configure Aider / self hosting: enter Base URL and masked API key.
# Supported model IDs are discovered from the endpoint automatically.
# Select Aider (Self hosted) for a stage, then choose its saved model.
# requirements.runner self-hosted
# requirements.model local-model
# Alternatively provide credentials with UNCLE_SELF_HOSTED_API_KEY.
