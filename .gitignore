.uncle/*
!.uncle/docs/
# The change attestation and its trust root are committed on the feature
# branch; a negation only works under `.uncle/*`, never `.uncle/`.
!.uncle/attestation.json
!.uncle/attestation.sig
!.uncle/allowed_signers

# Local agent workflow state
.uncle/workflow/state
.uncle/workflow/approvals/
.uncle/workflow/logs/
.uncle/workflow/change.diff
.uncle/workflow/change-stat.txt

# Per-project local config (committed template lives at .uncle/config.example)
.uncle/config

# Python bytecode
__pycache__/
*.pyc


# Self-hosted model credentials
.uncle/self-hosted-keys.json
.aider*
ADVERSARIAL_REVIEW.md
BASELINE_REPORT.md
CHANGE_PLAN.md
CHANGE_REQUEST.md
CHANGE_SPEC.md
CHANGE_TEST_REPORT.md
DEFECTS.md
IMPLEMENTATION_NOTES.md
MANUAL_CHECKLIST.md
VERIFICATION_REPORT.md
